# Foursquare Places API (Pro tier). Get key at https://location.foursquare.com/
# Required for map to fetch restaurants when zooming to new areas.
FOURSQUARE_API_KEY=

# Auth: secret for signing JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Vercel Cron: protects GET /api/cron/seed-mock-dates (mock dates every other day).
# Generate with: openssl rand -base64 32
# Add the same value in Vercel → Project → Settings → Environment Variables.
CRON_SECRET=
